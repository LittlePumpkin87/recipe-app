// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum Unit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
  CUP
  TABLESPOON
  TEASPOON
  PINCH
  BUNCH
  CLOVE
  SLICE
  PACK
  CAN
}

model Recipe {
  id           String   @id @default(uuid(7)) @db.Uuid
  title        String   @db.VarChar(50)
  description  String?
  instructions String
  servings     Int      @default(2)
  prepMinutes  Int?     @map("prep_minutes")
  sourceUrl    String?  @map("source_url")
  sourceName   String?  @map("source_name") @db.VarChar(150)
  externalId   String?  @map("external_id") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([sourceName, externalId])
  @@map("recipe")
}

model Ingredient {
  id              String            @id @default(uuid(7)) @db.Uuid
  name            String            @db.VarChar(120)
  nameNormalized  String            @unique @map("name_normalized") @db.VarChar(120)
  defaultUnit     Unit?             @map("default_unit")
  ingredientAlias IngredientAlias[]

  @@map("ingredient")
}

model IngredientAlias {
  id           String     @id @default(uuid(7)) @db.Uuid
  alias        String     @unique @db.VarChar(120)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String     @map("ingredient_id") @db.Uuid

  @@map("ingredient_alias")
}
