// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/** Enums for all used units inside the database. Does not provide the actual display name in frontend.
e.g. "Tablespoon" or "TS" in frontend are the same enum */
enum Unit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
  CUP
  TABLESPOON
  TEASPOON
  PINCH
  BUNCH
  CLOVE
  SLICE
  PACK
  CAN

  @@map("unit")
}

/** Recipe Model that provides all needed data for a whole recipe */
model Recipe {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title        String   @db.VarChar(50)
  description  String?
  instructions String
  servings     Int      @default(2)
  prepMinutes  Int?     @map("prep_minutes")
  totalMinutes Int?     @map("total_minutes")
  sourceUrl    String?  @map("source_url")
  sourceName   String?  @map("source_name") @db.VarChar(150)
  externalId   String?  @map("external_id") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  recipeIngredients RecipeIngredient[]

  @@unique([sourceName, externalId])
  @@map("recipe")
}

/** Model for a single ingredient, no matter if used in a recipe or not */
model Ingredient {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String             @db.VarChar(120)
  nameNormalized    String             @unique @map("name_normalized") @db.VarChar(120)
  defaultUnit       Unit?              @map("default_unit")
  ingredientAlias   IngredientAlias[]
  recipeIngredients RecipeIngredient[]

  @@map("ingredient")
}

/** This Model is used for alias names of specified ingredients. e.g. "Onions" and "Onion" */
model IngredientAlias {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  alias        String     @unique @db.VarChar(120)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String     @map("ingredient_id") @db.Uuid

  @@map("ingredient_alias")
}

/** This Model is used for ingredients which are used in a specific Recipe */
model RecipeIngredient {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  amount       Decimal?   @db.Decimal(8, 2)
  ingredientId String     @map("ingredient_id") @db.Uuid
  recipeId     String     @map("recipe_id") @db.Uuid
  unit         Unit?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  note         String?    @db.VarChar(80)
  groupLabel   String?    @map("group_label") @db.VarChar(100)
  position     Int

  @@index([ingredientId])
  @@index([recipeId])
  @@map("recipe_ingredient")
}
