# Copy this file to .env and set a password:
#   cp .env.example .env && openssl rand -base64 24
# POSTGRES_PASSWORD and the password inside DATABASE_URL must match.

POSTGRES_USER=recipe
POSTGRES_PASSWORD=
POSTGRES_DB=recipe
POSTGRES_PORT=5432

DATABASE_URL="postgresql://recipe:SET_YOUR_PASSWORD@localhost:5432/recipe?schema=public"
