### ───────────── Notes ─────────────
# Written for httpYac (VS Code extension anweber.vscode-httpyac, CLI httpyac).
# The same requests run against both backends. {{host}} comes from the
# environment in http-client.env.json, never from this file:
#   nest   = 3000  (npm run start:nest)
#   dotnet = 5000  (npm run start:dotnet)
# In the editor, pick the environment with httpYac's environment switch;
# without one, {{host}} is undefined. From the command line, seed included:
#   npm run test:nest
#   npm run test:dotnet
#   npm run compare      (both backends running, compares the responses)
# A @host line here would override the environment, so there is none.
#
# All seven endpoints exist on both sides. Where an answer differs on purpose,
# the request below says so.
#
# The status code is the contract, the error body is not: Nest sends
# { statusCode, message, error }, ASP.NET Core sends RFC 9457 ProblemDetails.
# A deliberate difference, see docs/DECISIONS.md.
#
# Three requests are named (# @name …). The name holds the parsed response body,
# so later requests read {{newRecipe.id}} and no UUID has to be pasted by hand.
# A request carrying # @ref newRecipe sends the named request first if it has
# no response yet in this session.
#
# The starting point is the seed (npm run db:seed): the ingredient catalog
# (apps/api/prisma/ingredient-catalog.json), then the recipes Langos and
# Römertopfbrot. 8 of their 17 ingredients come from the catalog, 9 are new.
#
# An ingredient name is looked up as an alias in the recipe's language. A name
# the catalog knows (Ei, Salz, cardamom) reuses that entry; test cases that need
# a new ingredient use names the catalog does not know.

### ───────────── GET /recipes ─────────────

### All recipes, ordered by title -> 200
# Named: the detail requests below take their id from this response.
# @name recipeList
GET {{host}}/recipes

?? status == 200

### Prefix of a word: finds Langos -> 200
GET {{host}}/recipes?search=lang

?? status == 200

### Case does not matter: finds Langos -> 200 (ILIKE on recipe.title)
GET {{host}}/recipes?search=LANGOS

?? status == 200

### Substring in the middle: finds Römertopfbrot -> 200
GET {{host}}/recipes?search=brot

?? status == 200

### Umlaut as written: finds Römertopfbrot -> 200
GET {{host}}/recipes?search=römer

?? status == 200

### Umlaut transliterated: finds nothing -> 200 with []
# Titles have no normalized column, "oe" is not resolved.
GET {{host}}/recipes?search=roemer

?? status == 200

### Search without a hit -> 200 with []
GET {{host}}/recipes?search=xyz

?? status == 200

### Empty search term: no filter, every recipe -> 200
GET {{host}}/recipes?search=

?? status == 200


### ───────────── GET /recipes/:id ─────────────

### First recipe from the list, including its ingredients -> 200
# Ingredients ordered by position, groupLabel and note per line.
# @ref recipeList
GET {{host}}/recipes/{{recipeList[0].id}}

?? status == 200

### Unknown but valid UUID v7 -> 404
GET {{host}}/recipes/00000000-0000-7000-8000-000000000000

?? status == 404

### Valid UUID v4 -> 400 in Nest, 404 in .NET
# A deliberate difference: ParseUUIDPipe checks the version, Guid has no notion
# of one.
GET {{host}}/recipes/3f6b2c1e-8a4d-4f7b-9c2e-5d1a7b3f8e60

?? js [400,404].includes(response.statusCode) isTrue

### Not a UUID -> 400
GET {{host}}/recipes/hallo

?? status == 400


### ───────────── POST /recipes ─────────────

### Create a recipe -> 201
# Six ingredient lines, but five ingredients: "Salz" and "  SALZ  " normalize
# to the same ingredient row and differ only in note and position. Sending it
# twice changes nothing about that — the ingredients are reused, only the
# recipe is new.
# Named: the PATCH section below works on this recipe.
# @name newRecipe
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "language": "DE",
  "description": "Reicht für zwei große Teller.",
  "servings": 2,
  "prepMinutes": 20,
  "totalMinutes": 45,
  "instructions": "1. Kartoffeln und Möhren **grob** würfeln.\n2. In der Brühe 20 Min. kochen, dann grob pürieren.\n3. Mit Salz und Majoran abschmecken.\n\n- schmeckt am zweiten Tag besser\n- Würstchen passen dazu",
  "ingredients": [
    { "name": "Kartoffeln", "amount": 800, "unit": "GRAM", "groupLabel": "Für die Suppe" },
    { "name": "Möhren", "amount": 2, "unit": "PIECE", "note": "mittelgroß", "groupLabel": "Für die Suppe" },
    { "name": "Gemüsebrühe", "amount": 1, "unit": "LITER", "groupLabel": "Für die Suppe" },
    { "name": "Salz", "amount": 1, "unit": "TEASPOON", "groupLabel": "Für die Suppe" },
    { "name": "  SALZ  ", "note": "zum Abschmecken", "groupLabel": "Zum Abschmecken" },
    { "name": "Majoran", "note": "getrocknet", "groupLabel": "Zum Abschmecken" }
  ]
}

?? status == 201

### Required fields only -> 201 with servings 2
# The default comes from the database, not from the DTO. The second ingredient
# line has neither amount nor unit — "salt to taste" is a valid case.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Spiegelei",
  "language": "DE",
  "instructions": "Butter in der Pfanne schmelzen, Ei hineingleiten lassen, salzen.",
  "ingredients": [
    { "name": "Ei", "amount": 2, "unit": "PIECE" },
    { "name": "Salz" }
  ]
}

?? status == 201

### servings given -> 201 with servings 4
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe für vier",
  "language": "DE",
  "instructions": "Wie oben, alles verdoppelt.",
  "servings": 4,
  "ingredients": [
    { "name": "Kartoffeln", "amount": 1600, "unit": "GRAM" }
  ]
}

?? status == 201

### German plural finds the catalog entry -> 201, "Eier" is the row "egg"
# (eier, DE) is an alias of the catalog entry egg/eggs/Ei/Eier.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Rührei",
  "language": "DE",
  "instructions": "Eier verquirlen und in der Pfanne stocken lassen.",
  "ingredients": [
    { "name": "Eier", "amount": 3, "unit": "PIECE" }
  ]
}

?? status == 201
?? js response.parsedBody.ingredients[0]?.nameEn == egg
?? js response.parsedBody.ingredients[0]?.nameDe == Ei

### English plural finds the same entry -> 201, "eggs" is the row "egg"
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Scrambled eggs",
  "language": "EN",
  "instructions": "Whisk the eggs and let them set in the pan.",
  "ingredients": [
    { "name": "eggs", "amount": 3, "unit": "PIECE" }
  ]
}

?? status == 201
?? js response.parsedBody.ingredients[0]?.nameEn == egg
?? js response.parsedBody.ingredients[0]?.nameDe == Ei

### English "paprika" is the spice -> 201
# The catalog maps (paprika, EN) to the powder, Paprikapulver in German.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Paprika chicken",
  "language": "EN",
  "instructions": "Rub the chicken with paprika and roast it.",
  "ingredients": [
    { "name": "paprika", "amount": 2, "unit": "TEASPOON" }
  ]
}

?? status == 201
?? js response.parsedBody.ingredients[0]?.nameDe == Paprikapulver

### German "Paprika" is not the spice -> 201, a new ingredient without nameEn
# The lookup runs in the recipe's language: there is no alias (paprika, DE),
# so the English spice is not reused.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Paprikagemüse",
  "language": "DE",
  "instructions": "Paprika in Streifen schneiden und anbraten.",
  "ingredients": [
    { "name": "Paprika", "amount": 2, "unit": "PIECE" }
  ]
}

?? status == 201
?? js response.parsedBody.ingredients[0]?.nameDe == Paprika
?? js response.parsedBody.ingredients[0]?.nameEn isFalse

### Unknown name -> 201, the new ingredient gets its name as an alias
# The POST /ingredients case "Teeblätter -> 409" below shows the alias exists.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Tee",
  "language": "DE",
  "instructions": "Teeblätter mit heißem Wasser übergießen, drei Minuten ziehen lassen.",
  "ingredients": [
    { "name": "Teeblätter", "amount": 2, "unit": "TEASPOON" }
  ]
}

?? status == 201
?? js response.parsedBody.ingredients[0]?.nameDe == Teeblätter

### Title of spaces only -> 400 (trimmed before it is validated)
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "   ",
  "language": "DE",
  "instructions": "Kartoffeln schälen …",
  "ingredients": [
    { "name": "Kartoffeln", "amount": 800, "unit": "GRAM" }
  ]
}

?? status == 400

### Without language -> 400
# The language decides where new ingredient names go (name_de or name_en), so
# the client has to say it; the column default DE is not a guess for the API.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "instructions": "Kartoffeln schälen …",
  "ingredients": [
    { "name": "Kartoffeln", "amount": 800, "unit": "GRAM" }
  ]
}

?? status == 400

### Empty ingredient list -> 400
# A recipe without ingredients is a text file.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "language": "DE",
  "instructions": "Kartoffeln schälen …",
  "ingredients": []
}

?? status == 400

### Ingredient line without a name -> 400 (the message names ingredients[0].name)
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "language": "DE",
  "instructions": "Kartoffeln schälen …",
  "ingredients": [
    { "amount": 800, "unit": "GRAM" }
  ]
}

?? status == 400

### Unknown field sourceUrl -> 400
# sourceUrl, sourceName and externalId are columns in the table but not in the
# DTO — they belong to the V3 importer.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "language": "DE",
  "instructions": "Kartoffeln schälen …",
  "sourceUrl": "https://example.org/kartoffelsuppe",
  "ingredients": [
    { "name": "Kartoffeln", "amount": 800, "unit": "GRAM" }
  ]
}

?? status == 400

### Unit outside the enum -> 400 (the message names ingredients[0].unit)
# "EL" is the display form, TABLESPOON is what gets stored.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "language": "DE",
  "instructions": "Kartoffeln schälen …",
  "ingredients": [
    { "name": "Mehl", "amount": 1, "unit": "EL" }
  ]
}

?? status == 400

### servings null -> 400
# The field may be omitted but must not be null: null would violate the
# NOT NULL column and end as a 500.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "language": "DE",
  "instructions": "Kartoffeln schälen …",
  "servings": null,
  "ingredients": [
    { "name": "Kartoffeln", "amount": 800, "unit": "GRAM" }
  ]
}

?? status == 400

### prepMinutes 0 -> 400 (times are positive or absent altogether)
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "language": "DE",
  "instructions": "Kartoffeln schälen …",
  "prepMinutes": 0,
  "ingredients": [
    { "name": "Kartoffeln", "amount": 800, "unit": "GRAM" }
  ]
}

?? status == 400

### amount with three decimal places -> 400
# numeric(8,2) would silently round it to 1.50.
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "language": "DE",
  "instructions": "Kartoffeln schälen …",
  "ingredients": [
    { "name": "Mehl", "amount": 1.505, "unit": "TABLESPOON" }
  ]
}

?? status == 400

### amount 0 -> 400 (amounts are positive; no amount means leaving it out)
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Kartoffelsuppe",
  "language": "DE",
  "instructions": "Kartoffeln schälen …",
  "ingredients": [
    { "name": "Mehl", "amount": 0, "unit": "TABLESPOON" }
  ]
}

?? status == 400


### ───────────── PATCH /recipes/:id ─────────────
# Works on the recipe from "Create a recipe" — send
# that POST once first.

### Change the title only -> 200
# A missing ingredients leaves the list untouched.
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{ "title": "Kartoffelcremesuppe" }

?? status == 200

### Clear both times with null -> 200, prepMinutes and totalMinutes are null
# Three fields are clearable and each carries its own flag, so each one can be
# wired up wrongly on its own. Check afterwards that description, which is not
# in this request, still holds the text from the POST.
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{ "prepMinutes": null, "totalMinutes": null }

?? status == 200

### Set one time without touching the other -> 200
# prepMinutes is 25 afterwards, totalMinutes stays null.
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{ "prepMinutes": 25 }

?? status == 200

### Clear description with null -> 200, description is null afterwards
# Clearable fields may be null, required ones may not.
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{ "description": null }

?? status == 200

### Replace the ingredient list only -> 200
# Four lines instead of six, positions 1–4, Pfeffer is new, Majoran is gone.
# The old lines are deleted rather than reconciled, so they come back with new
# ids. Check here: does updated_at change? A PATCH without recipe fields sends
# no UPDATE on recipe, so the trigger on recipe_ingredient sets it (issue #9).
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{
  "ingredients": [
    { "name": "Kartoffeln", "amount": 800, "unit": "GRAM" },
    { "name": "Möhren", "amount": 3, "unit": "PIECE" },
    { "name": "Gemüsebrühe", "amount": 1, "unit": "LITER" },
    { "name": "Pfeffer", "amount": 1, "unit": "PINCH", "note": "frisch gemahlen" }
  ]
}

?? status == 200
?? js response.parsedBody.ingredients[3]?.nameDe == Pfeffer
?? js response.parsedBody.ingredients[3]?.nameEn isFalse

### Switch the language and add a new ingredient -> 200, Sumac lands in nameEn
# The new ingredient takes the language of this request, not the stored one.
# Without language in the body it would take the stored DE (see the case above).
# Sumac, because the catalog does not know it; Cardamom would reuse its entry.
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{
  "language": "EN",
  "ingredients": [
    { "name": "Kartoffeln", "amount": 800, "unit": "GRAM" },
    { "name": "Sumac", "amount": 1, "unit": "PINCH" }
  ]
}

?? status == 200
?? js response.parsedBody.ingredients[1]?.nameEn == Sumac
?? js response.parsedBody.ingredients[1]?.nameDe isFalse

### language outside the enum -> 400
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{ "language": "FR" }

?? status == 400

### language null -> 400 (may be omitted, but not cleared)
# The column is NOT NULL. .NET tells "missing" from "null" with a flag in the
# setter, as for title and servings.
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{ "language": null }

?? status == 400

### title null -> 400 (required, not clearable)
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{ "title": null }

?? status == 400

### servings null -> 400
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{ "servings": null }

?? status == 400

### Empty ingredient list -> 400 (rule inherited from the create DTO)
# @ref newRecipe
PATCH {{host}}/recipes/{{newRecipe.id}}
Content-Type: application/json

{ "ingredients": [] }

?? status == 400

### Unknown but valid UUID -> 404
# Check afterwards: "Testpfeffer" must not be in ingredient. The recipe is
# looked up first, the ingredients are resolved only after that.
PATCH {{host}}/recipes/00000000-0000-7000-8000-000000000000
Content-Type: application/json

{
  "title": "Gibt es nicht",
  "ingredients": [
    { "name": "Testpfeffer", "amount": 1, "unit": "PINCH" }
  ]
}

?? status == 404

### Not a UUID -> 400
PATCH {{host}}/recipes/hallo
Content-Type: application/json

{ "title": "Kartoffelcremesuppe" }

?? status == 400


### ───────────── DELETE /recipes/:id ─────────────

### Create a throwaway recipe to delete -> 201
# @name throwawayRecipe
POST {{host}}/recipes
Content-Type: application/json

{
  "title": "Zum Löschen",
  "language": "DE",
  "instructions": "Wird gleich wieder gelöscht.",
  "ingredients": [
    { "name": "Testzutat", "amount": 1, "unit": "PIECE" }
  ]
}

?? status == 201

### Delete the recipe -> 204 without a body (send twice: 404 the second time)
# Check afterwards: "Testzutat" is still in ingredient. The cascade runs from a
# recipe to its lines only, never on to the ingredient.
# @ref throwawayRecipe
DELETE {{host}}/recipes/{{throwawayRecipe.id}}

?? status == 204

### Unknown but valid UUID -> 404
DELETE {{host}}/recipes/00000000-0000-7000-8000-000000000000

?? status == 404

### Not a UUID -> 400
DELETE {{host}}/recipes/hallo

?? status == 400


### ───────────── GET /ingredients ─────────────

### All ingredients, ordered by name, at most 20 -> 200
GET {{host}}/ingredients

?? status == 200

### Case does not matter: finds Majo -> 200
# The search term passes through the same normalisation as the column.
# The search reads name_normalized only, so catalog entries are found by their
# English key ("salt", not "Salz"). Searching all aliases comes with #44.
GET {{host}}/ingredients?search=MAJO

?? status == 200
?? js response.parsedBody[0]?.nameDe == Majo

### Spaces around the term: finds Majo -> 200
GET {{host}}/ingredients?search=%20majo%20

?? status == 200
?? js response.parsedBody[0]?.nameDe == Majo

### Repeated spaces inside the term: finds Saure Sahne -> 200
GET {{host}}/ingredients?search=saure%20%20%20sahne

?? status == 200
?? js response.parsedBody[0]?.nameDe == Saure Sahne

### Decomposed umlaut (O + diaeresis): finds Öl -> 200
# The case ILIKE alone does not solve — NFC normalisation does the work here.
GET {{host}}/ingredients?search=O%CC%88l

?? status == 200
?? js response.parsedBody[0]?.nameDe == Öl

### Upper case beyond ASCII: "ÖL" finds Öl -> 200
GET {{host}}/ingredients?search=%C3%96L

?? status == 200
?? js response.parsedBody[0]?.nameDe == Öl

### Search term of spaces only: no filter, same list as without search -> 200
GET {{host}}/ingredients?search=%20%20

?? status == 200

### Search without a hit -> 200 with []
GET {{host}}/ingredients?search=xyz

?? status == 200
?? js response.parsedBody.length == 0


### ───────────── POST /ingredients ─────────────

### Create an ingredient -> 201 (409 when sent a second time)
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Liebstöckel", "defaultUnit": "PIECE", "language": "DE" }

?? status == 201

### An existing ingredient spelled differently -> 409
# Every name is stored normalised as an alias, unique per language. "  SALZ  "
# normalises to (salz, DE), an alias of the catalog entry salt.
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "  SALZ  ", "language": "DE" }

?? status == 409

### Repeated spaces inside the name: same row as Saure Sahne -> 409
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Saure   Sahne", "language": "DE" }

?? status == 409

### Decomposed umlaut: same row as Öl -> 409
# "Ö" is O followed by a combining diaeresis. Written as a JSON escape so
# the file shows it; an editor could silently compose the raw character.
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Öl", "language": "DE" }

?? status == 409

### Upper case beyond ASCII: same row as Öl -> 409
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "ÖL", "language": "DE" }

?? status == 409

### Ingredient without defaultUnit -> 201 (the field is optional)
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Bärlauch", "language": "DE" }

?? status == 201

### English ingredient -> 201, the name lands in nameEn, nameDe stays null
# name_normalized holds the name in the language it was created in; a German
# name can only arrive later through an alias.
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "lovage", "language": "EN" }

?? status == 201
?? js response.parsedBody.nameEn == lovage
?? js response.parsedBody.nameDe isFalse

### A catalog name in its own language -> 409
# (eier, DE) is an alias of the catalog entry egg.
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Eier", "language": "DE" }

?? status == 409

### The same name in the other language -> 201, a different ingredient
# There is no alias (eier, EN), so "Eier" is free in English.
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Eier", "language": "EN" }

?? status == 201
?? js response.parsedBody.nameEn == Eier

### A name a recipe created -> 409
# POST /recipes "Tee" above created Teeblätter together with its alias.
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Teeblätter", "language": "DE" }

?? status == 409

### Without language -> 400
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Kurkuma" }

?? status == 400

### Name of spaces only -> 400 (trimmed before it is validated)
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "   ", "language": "DE" }

?? status == 400

### Unknown field id -> 400 (the database assigns the id)
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Kurkuma", "id": "abc", "language": "DE" }

?? status == 400

### Unit outside the enum -> 400
POST {{host}}/ingredients
Content-Type: application/json

{ "name": "Petersilie", "defaultUnit": "EL", "language": "DE" }

?? status == 400
